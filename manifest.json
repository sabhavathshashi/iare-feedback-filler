{
  "manifest_version": 3,
  "name": "IARE Feedback Filler",
  "version": "2.0.0",
  "description": "Apply the same Poor/Average/Good/Very Good/Excellent rating to every question on the IARE Samvidha feedback form with one click.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://samvidha.iare.ac.in/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "IARE Feedback Filler",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://samvidha.iare.ac.in/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
